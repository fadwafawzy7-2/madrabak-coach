# ===== مدربك الخاص — backend environment =====
# Never commit real secrets.

# --- AI chat (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Vision (Gemini) ---
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# --- Supabase (optional: auth/storage/Postgres host) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database ---
DATABASE_URL=postgresql+psycopg://coach:coach_dev_password@localhost:5432/coach_dev

# --- Auth ---
JWT_SECRET=change-me-in-production

# --- Google Play ---
GOOGLE_PLAY_PACKAGE_NAME=com.madrabak.coach
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# --- Environment ---
ENV=dev
